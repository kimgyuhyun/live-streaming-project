# cp .env.example .env 후 값을 바꿔서 쓴다. .env는 커밋하지 않는다.

# Oracle 관리자(SYS/SYSTEM) 비밀번호
ORACLE_PASSWORD=change-me

# 앱이 쓰는 DB 계정 (FREEPDB1에 자동 생성됨)
DB_USERNAME=app
DB_PASSWORD=change-me

# 운영자 계정. 둘 다 채우면 앱 시작 때 만든다. 그 이메일의 계정이 이미 있으면 바꾸지 않는다
OPERATOR_EMAIL=
OPERATOR_PASSWORD=

# 스튜디오 OBS 안내에 보여 줄 송출 서버 주소. 줄을 주석으로 두면 rtmp://localhost/live
# (빈 값으로 두면 빈 주소가 된다)
# APP_OBS_SERVER=rtmp://localhost/live

# Spring이 MediaMTX API(내부 :9997)를 부를 때 싣는 내부 비밀번호. 이것 없이는 내부망에서도 API를 부를 수 없다.
# 긴 난수로 바꾼다(예: openssl rand -base64 32)
MEDIAMTX_API_PASSWORD=change-me
